# Atomurus — environment variables (copy to .env for local `netlify dev`)
# Never commit real secrets. Production: Netlify dashboard → Environment variables.

# Auth provider: supabase | netlify-identity (auto-detects Supabase when URL+anon key exist)
# AUTH_PROVIDER=supabase

# Supabase Auth (account creation, login, sessions)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL for Supabase email redirects (production)
# AUTH_SITE_URL=https://atomurus.com

# CORS / origin allowlist (comma-separated)
# AUTH_ALLOWED_ORIGINS=https://atomurus.com,https://www.atomurus.com
# ALLOWED_ORIGIN=https://atomurus.com

# Contact form (Mailgun) — existing
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# CONTACT_TO=
# CONTACT_FROM=
# MAILGUN_BASE_URL=https://api.mailgun.net

# Billing webhooks (future — server only, never expose to client)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MERCADOPAGO_ACCESS_TOKEN=

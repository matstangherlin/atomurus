  "tool": { "href": { "pt": "/calculators.pt.html#molar", "en": "/calculators.html#molar" }, "label": { "pt": "Abrir a calculadora de massa molar", "en": "Open the molar mass calculator" } },
  "template": { "pt": "Calcule a massa molar de {formula}.", "en": "Calculate the molar mass of {formula}." },
